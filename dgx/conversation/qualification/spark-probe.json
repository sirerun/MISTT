{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "mistt-whisper-anna-cpu-20261013-05"
  },
  "spec": {
    "restartPolicy": "Never",
    "containers": [
      {
        "name": "probe",
        "image": "nvcr.io/nvidia/pytorch:26.02-py3",
        "command": [
          "/usr/bin/python3",
          "-c",
          "import base64,json,pathlib,subprocess,sys,os\nfiles=json.loads(base64.b64decode(''))\nfor name,text in files.items():pathlib.Path(name).write_text(text)\nsubprocess.run([sys.executable,'/work/prepare_model.py','--pins','/work/model-pins.json','--output','/work/whisper'],check=True,timeout=240)\nsubprocess.run([sys.executable,'-m','pip','install','--quiet','--no-deps','--target','/work/pinned-pocket','https://github.com/kyutai-labs/pocket-tts/archive/b94db177bc0f77517d9b124843e25605d6f9aed8.tar.gz'],check=True,timeout=90)\nsubprocess.run([sys.executable,'/work/stage_anna.py','--hub','/hub','--pocket-package','/deps/pocket_tts','--output','/models'],check=True,timeout=60)\nsubprocess.run([sys.executable,'-m','pip','install','--quiet','--target','/work/stt-deps','--report','/work/install-report.json','-r','/work/requirements.txt'],check=True,timeout=180)\nos.environ['PYTHONPATH']='/work/pinned-pocket:/work/stt-deps:/deps'\nsubprocess.run([sys.executable,'/work/probe.py'],check=True,timeout=330)\n"
        ],
        "env": [
          {
            "name": "PYTHONPATH",
            "value": "/deps"
          },
          {
            "name": "OMP_NUM_THREADS",
            "value": "2"
          },
          {
            "name": "OPENBLAS_NUM_THREADS",
            "value": "2"
          }
        ],
        "resources": {
          "limits": {
            "cpu": "4",
            "memory": "4Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "packages",
            "mountPath": "/deps",
            "readOnly": true
          },
          {
            "name": "hub",
            "mountPath": "/hub",
            "readOnly": true
          },
          {
            "name": "work",
            "mountPath": "/work",
            "readOnly": false
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "packages",
        "hostPath": {
          "path": "/var/lib/zerfoo/vibevoice-cache/venv/lib/python3.12/site-packages"
        }
      },
      {
        "name": "hub",
        "hostPath": {
          "path": "/var/lib/zerfoo/vibevoice-cache/hf/hub"
        }
      },
      {
        "name": "work",
        "emptyDir": {}
      }
    ]
  }
}
