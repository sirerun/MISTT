{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "${MISTT_PROOF_POD_NAME}",
    "labels": {
      "app": "mistt",
      "purpose": "bounded-asr-qualification"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "containers": [
      {
        "name": "proof",
        "image": "nvcr.io/nvidia/pytorch@sha256:bbc2b67e2533edd63ff1496bb1ed00a00338cdc1478af6c1a0bf9f4b369977e7",
        "command": [
          "bash",
          "-lc"
        ],
        "args": [
          "timeout 2400 /task/bootstrap.sh"
        ],
        "resources": {
          "limits": {
            "memory": "48Gi",
            "cpu": "4",
            "nvidia.com/gpu": "1"
          }
        },
        "volumeMounts": [
          {
            "name": "task",
            "mountPath": "/task"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "task",
        "hostPath": {
          "path": "${MISTT_DGX_TASK_DIR}",
          "type": "Directory"
        }
      }
    ]
  }
}
